# ==============================================================================
# LOHAS Architects Environment Variables & Cloud Storage Setup Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Storage 연동 설정 (추천: 빠른 CDN & Public URL 제공)
# ------------------------------------------------------------------------------
# [설정 방법]
# 1) Supabase(https://supabase.com)에 로그인 후 프로젝트 생성 또는 선택
# 2) 좌측 메뉴 'Storage' > 'New bucket' 생성
#    - Name: portfolio-images
#    - Public bucket 토글: 반드시 [ON (Checked)] 활성화! (비로그인 방문자 열람 필수)
# 3) 좌측 메뉴 'Settings' > 'API'에서 Project URL 및 anon/public API Key 복사
# 4) 아래 환경 변수에 설정:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_BUCKET="portfolio-images"

# ------------------------------------------------------------------------------
# 2. Firebase Storage 연동 설정
# ------------------------------------------------------------------------------
# [설정 방법]
# 1) Firebase 콘솔 (https://console.firebase.google.com) > 프로젝트 선택
# 2) 'Build' > 'Storage' 메뉴에서 시작하기(Get Started)로 버킷 생성
# 3) 'Rules(규칙)' 탭에서 공개 읽기 권한 설정:
#    rules_version = '2';
#    service firebase.storage {
#      match /b/{bucket}/o {
#        match /portfolios/{allPaths=**} {
#          allow read: if true;
#          allow write: if request.auth != null;
#        }
#      }
#    }
# 4) 아래 환경 변수 설정 (기본값은 firebase-applet-config.json의 storageBucket 자동 참조):
VITE_FIREBASE_STORAGE_BUCKET="project-fa326924-9f5d-4948-b7e.firebasestorage.app"

# ------------------------------------------------------------------------------
# 3. AI Studio & Server 기본 설정
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: AI 모델 연동 시 사용
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: 호스팅 도메인 URL (Cloud Run/배포 도메인)
APP_URL="MY_APP_URL"
PORT=3000
